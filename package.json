{
  "name": "fusion-launcher",
  "productName": "Fusion Launcher",
  "version": "0.13.0",
  "description": "Minecraft Java launcher with in-game controls, mods and modpacks",
  "author": "Fusion",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "electron .",
    "build": "node scripts/build-runtime.cjs && node scripts/assets.cjs && vite build && node scripts/build-uninstaller.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/build-installer.cjs && npm run release:prepare",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke-persistence.cjs && node scripts/smoke-v011.cjs && node scripts/smoke-v012.cjs && node scripts/smoke-v013.cjs",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "build:mods": "node scripts/build-runtime.cjs",
    "test:mods": "node scripts/test-runtime.cjs",
    "release:prepare": "node scripts/prepare-release.cjs",
    "build:installer": "node scripts/build-installer.cjs",
    "test:mappings": "node scripts/audit-runtime.cjs"
  },
  "dependencies": {
    "@xmcl/core": "2.14.0",
    "@xmcl/installer": "6.0.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skinview3d": "^3.4.2",
    "undici": "6.28.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "sharp": "^0.35.4",
    "vite": "^6.3.0",
    "yazl": "2.5.1"
  },
  "overrides": {
    "@xmcl/unzip": {
      ".": "2.1.2",
      "yauzl": "3.4.0"
    },
    "undici": "6.28.1",
    "@xmcl/file-transfer": "2.0.3"
  },
  "build": {
    "appId": "app.fusion.launcher",
    "productName": "Fusion Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/assets/fusion-world.*",
      "!dist/assets/versions/*-original.png",
      "electron/**/*",
      "package.json",
      "docs/UPDATES.md",
      "docs/MICROSOFT-SETUP.md",
      "LICENSE",
      "docs/PRIVACY.md",
      "docs/TERMS.md"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Fusion-Launcher-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Fusion-Setup-${version}.exe",
      "include": "installer/custom.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MasterGab1",
        "repo": "Fusion-Client",
        "releaseType": "draft",
        "channel": "latest",
        "private": true
      }
    ],
    "extraFiles": [
      {
        "from": "build/Fusion-Uninstall.exe",
        "to": "Fusion-Uninstall.exe"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MasterGab1/Fusion-Client.git"
  },
  "microsoftClientId": "7d62351c-268c-4fbe-95d5-89611193ab12",
  "discordApplicationId": "1543243710588915732"
}
